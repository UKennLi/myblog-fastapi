# Copy to .env and set real deployment values; never commit .env.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=myblog_db
DB_USER=blog_app
DB_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DB_TIMEZONE=Asia/Shanghai
DISPLAY_TIMEZONE=UTC
SESSION_FILE=state/sessions.sqlite3
SESSION_TIMEOUT=1800
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=10485760
# true when browsers access exclusively through HTTPS
COOKIE_SECURE=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Keep the original malformed root JS for strict behavior compatibility.
LEGACY_TEMPLATE_JS=true
